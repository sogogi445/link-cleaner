{
  "manifest_version": 3,
  "name": "공유 링크 꼬리표 제거",
  "version": "1.0.0",
  "description": "공유하기/링크 복사 시 붙는 추적 꼬리표(si, s, utm_* 등)를 자동으로 지웁니다.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["clean.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
